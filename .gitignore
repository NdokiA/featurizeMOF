# ==========================================
# Jupyter Notebooks (.ipynb)
# ==========================================
# Ignore hidden autosave checkpoints generated by Jupyter
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Optional: Ignore Jupyter lab workspace states
.jupyter
*.ipynb_checkpoints

# ==========================================
# Python Core & Bytecode
# ==========================================
# Ignore compiled Python files
__pycache__/
*.py[cod]
*$py.class

# Ignore C extensions
*.so

# ==========================================
# Virtual Environments (Pick yours)
# ==========================================
.venv/
venv/
ENV/
env/
*.env

# ==========================================
# Environment Variables & Secrets
# ==========================================
# NEVER commit your secrets, API keys, or configurations
.env
.env.*
secrets.json
config.json

# ==========================================
# IDEs and Editors
# ==========================================
# VS Code
.vscode/

# PyCharm / IntelliJ
.idea/

# Mac OS files
.DS_Store

